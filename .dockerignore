# Whitelist: the image build needs exactly what a clean clone provides —
# ignore everything, then re-include the build + serve inputs. This keeps an
# image built from a working dev checkout (scratch shots, feedback pins,
# local rigs, user-customization art) identical to one built from a fresh
# `git clone`, and keeps the build context small.
*
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!index.html
!remote.html
!src
!public
!tools/check-file-budget.mjs
!tools/check-provider-boundary.mjs
!tools/list-slots.mjs
!tools/remote-play-server.mjs

# The front door. Needed at BUILD time (`npm run build` runs `tsc -p server`)
# and at RUN time (the entrypoint execs server/index.ts), so leaving it out of
# this whitelist produced an image with no gate in it at all.
!server

# The container entrypoint, which starts the store on loopback and the front
# door on the public port. Only this one file from deploy/ — the systemd unit,
# the install scripts and the icons are host-side tooling with no place in an
# image.
!deploy/docker-entrypoint.sh

# Local-only dev rigs that may sit inside the re-included dirs on a dev
# checkout (absent from a clean clone; vite.config treats their entry pages
# as optional).
src/harness.ts
src/harness-boot.ts
src/asset-viewer.ts
public/colorcheck.html
public/sign-kit

# User-customization art never ships in an image — the repo's generic
# fallbacks do (see public/user-assets/README.md).
public/user-assets

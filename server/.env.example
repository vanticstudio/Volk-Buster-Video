# ── Front door configuration ─────────────────────────────────────────────────
#
# YOU DO NOT NEED THIS FILE. It exists for deployments that manage secrets
# externally (Docker secrets, a vault, a CI-provisioned host).
#
# By default nothing here is required. The front door generates its own signing
# and encryption keys on first boot and keeps them in instance.json beside the
# database, and the Plex server it gates on is chosen in the browser during
# setup. Start it, read the setup code from the log, and follow the page:
#
#   npm run serve &     # the store, on loopback
#   npm run server      # the front door, on :3355
#
# Anything set here WINS over the generated values.

# ── Optional ─────────────────────────────────────────────────────────────────

# The one public port. The store app stays on loopback behind it, so this is the
# only thing cloudflared or a router should ever see. Exposing APP_PORT directly
# would serve the whole library with no gate.
PORT=3355

# The store app's own port. Loopback only — never publish this one.
APP_PORT=1420

# Where instance.json and store.db live. Back this directory up like a
# credential store, because that is what it is.
DATABASE_PATH=./store.db

# ── Externally managed secrets (all optional) ────────────────────────────────
#
# Set these ONLY if you would rather provision them yourself. Generate the two
# keys with:  openssl rand -hex 32

# Skips the setup page entirely and gates on this server immediately. It is your
# Plex server's clientIdentifier, from:
#   https://plex.tv/api/v2/resources?X-Plex-Token=YOUR_TOKEN
# PLEX_MACHINE_ID=

# Signs session cookies. Anyone who learns it can mint a session as any user.
# SESSION_SECRET=

# Encrypts viewers' Plex tokens at rest. Rotating it invalidates every existing
# session — people sign in again, nothing else is lost.
# TOKEN_ENCRYPTION_KEY=

# ── Tuning ───────────────────────────────────────────────────────────────────

# How long a session lasts before a fresh Plex sign-in (default 30 days).
SESSION_TTL_MS=2592000000

# The revocation window: unshare a Plex library and that person loses access
# within this long, rather than whenever their session would have expired.
REVALIDATE_AFTER_MS=86400000

# ── Front door configuration ─────────────────────────────────────────────────
#
# Copy to .env and fill in. The service REFUSES TO START without the three
# required values, deliberately: each one fails silently and dangerously when
# absent, and a server that boots into a broken security posture is worse than
# one that does not boot.
#
#   node --experimental-strip-types server/index.ts
#   npm run server

# ── Required ─────────────────────────────────────────────────────────────────

# The Plex server this store gates on. Everyone who can reach THIS server in
# Plex can enter the store; nobody else can. Find it at:
#   https://plex.tv/api/v2/resources?X-Plex-Token=YOUR_TOKEN
# and take the `clientIdentifier` of your server.
#
# Getting this wrong locks everyone out (it fails closed, which is the safe
# direction, but it looks exactly like a Plex outage — check here first).
PLEX_MACHINE_ID=

# Signs session cookies. Anyone who learns this can mint a session for any
# account, including yours, so treat it like a password. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Encrypts viewers' Plex tokens at rest. Without it the database is a plaintext
# credential store for everyone you shared a library with. Same generator:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Rotating this invalidates every existing session — people sign in again.
# Nothing else is lost.
TOKEN_ENCRYPTION_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────

# Port the front door listens on — the ONE public port. The store app stays on
# loopback behind it, so this is the only thing cloudflared or a router should
# ever see. Exposing APP_PORT directly would serve the whole library with no gate.
PORT=3355

DATABASE_PATH=./store.db

# How long a session lasts before a fresh Plex sign-in (default 30 days).
SESSION_TTL_MS=2592000000

# How often a LIVE session is re-checked against Plex sharing (default 1 day).
# This is the revocation window: unshare a library and that person loses access
# within this long, rather than whenever their session would have expired.
REVALIDATE_AFTER_MS=86400000

# Shown in your Plex account's device list. Cosmetic and safe to change.
PLEX_PRODUCT=VolkBuster Video

# Stable per-install id. Plex keys session eviction off this, so once set it
# must NOT change — a new value looks like a brand-new device every restart and
# can retire tokens belonging to your other Plex clients.
PLEX_CLIENT_ID=volkbuster-front-door

# Where the built client lives, and the loopback origin of the internal store
# app. Neither should ever be a public address.
DIST_DIR=./dist
APP_ORIGIN=http://127.0.0.1:1420

# The store app's own port. Loopback only — never publish this one.
APP_PORT=1420
